{{>layouts/header}}

<div class="container mt-4 pb-5" style="max-width:720px;">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 fw-semibold" style="color:#1e293b;">합격률 기반 교재 추천</h6>
        <a href="/reviews" class="btn btn-soft btn-sm" style="font-size:0.8rem;">대시보드로</a>
    </div>

    <!-- 자격증 선택 -->
    <div class="card mb-4">
        <div class="card-header">자격증 선택</div>
        <div style="padding:1rem 1.25rem;">
            <form method="get" action="/reviews/recommend" class="row g-2 align-items-end">
                <div class="col">
                    <div class="section-label mb-1">자격증 이름</div>
                    <input type="text" class="form-control form-control-sm" name="certName"
                           value="{{certName}}" list="certDatalist"
                           placeholder="자격증을 선택하거나 직접 입력하세요" autocomplete="off">
                    <datalist id="certDatalist">
                        {{#certNames}}
                        <option value="{{.}}">
                        {{/certNames}}
                    </datalist>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm px-4">추천 보기</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 추천 결과 -->
    {{#hasResult}}
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>{{certName}} 교재 추천</span>
            <span class="badge badge-indigo">합격률 순</span>
        </div>

        {{#recommendations}}
        <div style="padding:1rem 1.25rem; border-bottom:1px solid #f1f5f9;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="fw-semibold" style="font-size:0.92rem; color:#1e293b;">{{bookTitle}}</div>
                    <div class="mt-1" style="font-size:0.78rem; color:#94a3b8;">
                        총 {{totalCount}}개 리뷰 &nbsp;·&nbsp; 합격 {{passedCount}}명 &nbsp;·&nbsp; 평균 공부 기간 {{avgStudyPeriod}}
                    </div>
                </div>
                <span class="badge badge-indigo ms-3" style="font-size:0.82rem; padding:0.4em 0.75em;">{{passRate}}</span>
            </div>
            <div class="progress" style="height:6px;">
                <div class="progress-bar" style="background:#818cf8; width:{{passRateNum}}%; border-radius:10px;"></div>
            </div>
        </div>
        {{/recommendations}}

        {{^recommendations}}
        <div class="card-body text-center py-5" style="color:#94a3b8; font-size:0.85rem;">
            해당 자격증의 리뷰 데이터가 없습니다.
        </div>
        {{/recommendations}}
    </div>
    {{/hasResult}}

    {{^hasResult}}
    <div class="card">
        <div class="card-body text-center py-5" style="color:#94a3b8; font-size:0.85rem;">
            자격증을 선택하면 합격률 기준으로 교재를 추천해드립니다.
        </div>
    </div>
    {{/hasResult}}

</div>

{{>layouts/footer}}
