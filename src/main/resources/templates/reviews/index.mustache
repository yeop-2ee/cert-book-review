{{>layouts/header}}

<div class="container mt-4 pb-5">

    <!-- 통계 카드 -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#818cf8;"></div>
                <div class="stat-num">{{total}}</div>
                <div class="stat-label">총 리뷰 수</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#34d399;"></div>
                <div class="stat-num">{{certCount}}</div>
                <div class="stat-label">등록 자격증 수</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#fbbf24;"></div>
                <div class="stat-num">{{passRate}}</div>
                <div class="stat-label">전체 합격률</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#f472b6;"></div>
                <div class="stat-num">{{passedCount}}</div>
                <div class="stat-label">합격자 리뷰 수</div>
            </div>
        </div>
    </div>

    <!-- 교재 랭킹 TOP5 + 최신 합격 후기 -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">합격자 기준 교재 TOP 5</div>
                <div style="padding:0.6rem 1rem 0;">
                    <input type="text" id="top5Search" class="form-control form-control-sm"
                           placeholder="자격증 검색" oninput="filterTop5(this.value)"
                           autocomplete="off">
                </div>
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="width:40px;" class="text-center">순위</th>
                            <th>자격증 / 교재명</th>
                            <th style="width:60px;" class="text-center">합격자</th>
                        </tr>
                    </thead>
                    <tbody id="top5Body">
                        {{#top5RankList}}
                        <tr data-cert="{{certName}}">
                            <td class="text-center fw-bold" style="color:#6366f1; white-space:nowrap;">{{rank}}</td>
                            <td>
                                <div style="font-size:0.8rem;">{{bookTitle}}</div>
                                <div style="font-size:0.73rem; color:#94a3b8;">{{certName}}</div>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-indigo">{{count}}</span>
                            </td>
                        </tr>
                        {{/top5RankList}}
                    </tbody>
                </table>
                <div class="card-footer text-end">
                    <a href="/reviews/ranking" class="btn btn-soft btn-sm">전체 보기</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">최신 합격 후기</div>
                <ul class="list-group list-group-flush">
                    {{#recentPassedList}}
                    <li class="list-group-item px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge badge-green me-1">합격</span>
                                <strong style="font-size:0.88rem;">{{certName}}</strong>
                                <div class="mt-1" style="font-size:0.77rem; color:#94a3b8;">{{bookTitle}} · {{studyPeriod}}</div>
                            </div>
                            <a href="/reviews/{{id}}" class="btn btn-soft btn-sm">보기</a>
                        </div>
                    </li>
                    {{/recentPassedList}}
                </ul>
            </div>
        </div>
    </div>

    <!-- 자격증별 요약 -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>자격증별 요약</span>
            <span class="result-count" style="padding:0; border:none; font-size:0.77rem;">총 {{certFilteredCount}}개</span>
        </div>
        <div style="padding:0.7rem 1.25rem; background:#f8fafc; border-bottom:1px solid #e5e7eb;">
            <form id="certSearchForm" method="get" action="/reviews">
                <input type="hidden" name="searchCert" value="{{searchCert}}">
                <input type="hidden" name="filterPassed" value="{{filterPassed}}">
                <input type="hidden" name="filterDifficulty" value="{{filterDifficulty}}">
                <input type="hidden" name="page" value="{{currentPage}}">
                <input type="text" class="form-control form-control-sm" name="certSearch"
                       id="certSearchInput" value="{{certSearch}}"
                       placeholder="자격증 검색" autocomplete="off">
            </form>
        </div>

        <table class="table mb-0">
            <thead>
                <tr>
                    <th>자격증</th>
                    <th class="text-center" style="width:70px;">리뷰 수</th>
                    <th style="min-width:140px;">합격률</th>
                    <th class="text-center" style="width:80px;">난이도</th>
                    <th>주요 교재</th>
                    <th class="text-center" style="width:110px;">바로가기</th>
                </tr>
            </thead>
            <tbody>
                {{#pagedCertList}}
                <tr>
                    <td class="fw-semibold" style="white-space:nowrap;">{{certName}}</td>
                    <td class="text-center" style="color:#94a3b8;">{{totalCount}}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1">
                                <div class="progress-bar" style="background:#818cf8; width:{{passRateNum}}%; border-radius:10px;"></div>
                            </div>
                            <small style="min-width:34px; color:#6366f1; font-weight:600; text-align:right;">{{passRate}}</small>
                        </div>
                    </td>
                    <td class="text-center">
                        {{#diffLow}}<span class="badge badge-green">하</span>{{/diffLow}}
                        {{#diffMid}}<span class="badge badge-amber">중</span>{{/diffMid}}
                        {{#diffHigh}}<span class="badge badge-red">상</span>{{/diffHigh}}
                    </td>
                    <td style="color:#94a3b8; font-size:0.83rem;">{{topBook}}</td>
                    <td class="text-center" style="white-space:nowrap;">
                        <a href="/reviews/stats?certName={{certName}}" class="btn btn-sm me-1" style="background:#eef2ff; border:1px solid #c7d2fe; color:#6366f1; font-size:0.75rem;">통계</a>
                        <a href="/reviews/ranking?certName={{certName}}" class="btn btn-sm" style="background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a; font-size:0.75rem;">교재 추천</a>
                    </td>
                </tr>
                {{/pagedCertList}}
            </tbody>
        </table>

        <div class="d-flex justify-content-center py-2">
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    {{#certHasPrev}}
                    <li class="page-item">
                        <a class="page-link" href="/reviews?certPage={{certPrevPage}}&{{{certFilterQuery}}}">이전</a>
                    </li>
                    {{/certHasPrev}}
                    {{#certPageItems}}
                    <li class="page-item {{#active}}active{{/active}}">
                        <a class="page-link" href="/reviews?certPage={{pageNum}}&{{{certFilterQuery}}}">{{pageNum}}</a>
                    </li>
                    {{/certPageItems}}
                    {{#certHasNext}}
                    <li class="page-item">
                        <a class="page-link" href="/reviews?certPage={{certNextPage}}&{{{certFilterQuery}}}">다음</a>
                    </li>
                    {{/certHasNext}}
                </ul>
            </nav>
        </div>
    </div>

    <!-- 전체 리뷰 목록 -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>전체 리뷰 목록</span>
            <a href="/reviews/new" class="btn btn-primary btn-sm">리뷰 작성</a>
        </div>

        <!-- 검색 / 필터 -->
        <div class="filter-bar">
            <form id="reviewFilterForm" method="get" action="/reviews" class="row g-2 align-items-end">
                <input type="hidden" name="certSearch" value="{{certSearch}}">
                <input type="hidden" name="certPage" value="1">
                <div class="col-md-4">
                    <div class="section-label mb-1">자격증 / 교재명</div>
                    <input type="text" id="searchCertInput" class="form-control form-control-sm"
                           name="searchCert" value="{{searchCert}}" placeholder="검색어 입력">
                </div>
                <div class="col-md-3">
                    <div class="section-label mb-1">합격 여부</div>
                    <select id="filterPassedSelect" class="form-select form-select-sm" name="filterPassed">
                        <option value="all">전체</option>
                        <option value="Y" {{#filterPassedY}}selected{{/filterPassedY}}>합격</option>
                        <option value="N" {{#filterPassedN}}selected{{/filterPassedN}}>불합격</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="section-label mb-1">난이도</div>
                    <select id="filterDiffSelect" class="form-select form-select-sm" name="filterDifficulty">
                        <option value="all">전체</option>
                        <option value="하" {{#filterDiffLow}}selected{{/filterDiffLow}}>하</option>
                        <option value="중" {{#filterDiffMid}}selected{{/filterDiffMid}}>중</option>
                        <option value="상" {{#filterDiffHigh}}selected{{/filterDiffHigh}}>상</option>
                    </select>
                </div>
            </form>
        </div>

        <div class="result-count">총 {{filteredCount}}건</div>

        <table class="table mb-0">
            <thead>
                <tr>
                    <th style="width:60px;">번호</th>
                    <th>자격증</th>
                    <th>교재</th>
                    <th class="text-center" style="width:80px;">난이도</th>
                    <th class="text-center" style="width:70px;">합격</th>
                    <th style="width:100px;">공부기간</th>
                </tr>
            </thead>
            <tbody>
                {{#reviewList}}
                <tr onclick="location.href='/reviews/{{id}}'" style="cursor:pointer;">
                    <td style="color:#cbd5e1;">{{id}}</td>
                    <td>{{certName}}</td>
                    <td style="color:#64748b;">{{bookTitle}}</td>
                    <td class="text-center">
                        {{#diffLow}}<span class="badge badge-green">하</span>{{/diffLow}}
                        {{#diffMid}}<span class="badge badge-amber">중</span>{{/diffMid}}
                        {{#diffHigh}}<span class="badge badge-red">상</span>{{/diffHigh}}
                    </td>
                    <td class="text-center">
                        {{#passedY}}<span class="badge badge-green">합격</span>{{/passedY}}
                        {{#passedN}}<span class="badge badge-red">불합격</span>{{/passedN}}
                    </td>
                    <td style="color:#94a3b8;">{{studyPeriod}}</td>
                </tr>
                {{/reviewList}}
            </tbody>
        </table>

        <div class="d-flex justify-content-center py-3">
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    {{#hasPrev}}
                    <li class="page-item">
                        <a class="page-link" href="/reviews?page={{prevPage}}&{{{filterQuery}}}">이전</a>
                    </li>
                    {{/hasPrev}}
                    {{#pageItems}}
                    <li class="page-item {{#active}}active{{/active}}">
                        <a class="page-link" href="/reviews?page={{pageNum}}&{{{filterQuery}}}">{{pageNum}}</a>
                    </li>
                    {{/pageItems}}
                    {{#hasNext}}
                    <li class="page-item">
                        <a class="page-link" href="/reviews?page={{nextPage}}&{{{filterQuery}}}">다음</a>
                    </li>
                    {{/hasNext}}
                </ul>
            </nav>
        </div>
    </div>

</div>

<script>
// 자격증별 요약 검색 — 타이핑 후 300ms 자동 submit
(function() {
    var input = document.getElementById("certSearchInput");
    var form  = document.getElementById("certSearchForm");
    if (!input) return;
    var timer;
    input.addEventListener("input", function() {
        clearTimeout(timer);
        timer = setTimeout(function() { form.submit(); }, 300);
    });
})();

// 전체 리뷰 필터 — 텍스트 300ms debounce, select 즉시 submit
(function() {
    var form   = document.getElementById("reviewFilterForm");
    var textInput = document.getElementById("searchCertInput");
    var selects   = [document.getElementById("filterPassedSelect"),
                     document.getElementById("filterDiffSelect")];
    if (!form) return;
    var timer;
    textInput.addEventListener("input", function() {
        clearTimeout(timer);
        timer = setTimeout(function() { form.submit(); }, 300);
    });
    selects.forEach(function(sel) {
        sel.addEventListener("change", function() { form.submit(); });
    });
})();

// TOP5 자격증 검색 — 즉시 JS 필터
function filterTop5(query) {
    var keyword = query.trim().toLowerCase();
    document.querySelectorAll("#top5Body tr").forEach(function(row) {
        var cert = (row.getAttribute("data-cert") || "").toLowerCase();
        row.style.display = (keyword === "" || cert.includes(keyword)) ? "" : "none";
    });
}
</script>

{{>layouts/footer}}
