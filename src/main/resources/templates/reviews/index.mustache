{{! ========================================================
    index.mustache - 메인 대시보드 페이지
    URL: GET /reviews
    데이터 (ReviewController.index()에서 전달):
      - totalFmt        : 총 리뷰 수 (천단위 콤마 포맷)
      - certCountFmt    : 등록 자격증 수
      - passRate        : 전체 합격률 (예: "72%")
      - passedCountFmt  : 합격자 리뷰 수
      - top5RankList    : 합격자 기준 교재 TOP5 (List<BookRank>)
      - recentPassedList: 최신 합격 후기 5개 (List<Review>)
      - certSummaryList : 자격증별 요약 (List<CertSummary>)
      - reviewList      : 전체 리뷰 목록 (클라이언트 JS 필터링용)
    기능:
      1. 통계 카드 4개 (총 리뷰, 자격증 수, 합격률, 합격자 수)
      2. 교재 TOP5 테이블 + 자격증명 검색 필터
      3. 최신 합격 후기 5개
      4. 자격증별 요약 테이블 (5개/페이지, 검색 + 페이지네이션)
      5. 전체 리뷰 목록 (10개/페이지, 자격증/교재/합격여부/난이도 필터 + 페이지네이션)
    참고: 필터링·페이지네이션은 모두 클라이언트 JS 처리 (서버 재요청 없음)
======================================================== }}
{{>layouts/header}}

<div class="container mt-4 pb-5">

    {{! 통계 카드 4개: stat-card 클래스에 fade+slide-up 진입 애니메이션 적용 (footer.js)
        stat-line: 카드 상단 컬러 바 (footer.js에서 width 0 → 100% 애니메이션)
        stat-num: 숫자 표시 영역 }}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#818cf8;"></div>  {{! 인디고 }}
                <div class="stat-num">{{totalFmt}}</div>
                <div class="stat-label">총 리뷰 수</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#34d399;"></div>  {{! 에메랄드 }}
                <div class="stat-num">{{certCountFmt}}</div>
                <div class="stat-label">등록 자격증 수</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#fbbf24;"></div>  {{! 앰버 }}
                <div class="stat-num">{{passRate}}</div>
                <div class="stat-label">전체 합격률</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-line" style="background:#f472b6;"></div>  {{! 핑크 }}
                <div class="stat-num">{{passedCountFmt}}</div>
                <div class="stat-label">합격자 리뷰 수</div>
            </div>
        </div>
    </div>

    {{! 교재 TOP5 + 최신 합격 후기 2열 레이아웃 }}
    <div class="row g-3 mb-4">
        {{! 교재 TOP5 카드
            top5Search: 자격증명 검색 필터 (oninput → filterTop5 JS 함수)
            data-cert: filterTop5()에서 행 표시/숨김 조건에 사용 }}
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">합격자 기준 교재 TOP 5</div>
                <div style="padding:0.6rem 1rem 0;">
                    <input type="text" id="top5Search" class="form-control form-control-sm"
                           placeholder="자격증 검색" oninput="filterTop5(this.value)" autocomplete="off">
                </div>
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="width:40px; white-space:nowrap;" class="text-center">순위</th>
                            <th>자격증 / 교재명</th>
                            <th style="width:60px; white-space:nowrap;" class="text-center">합격자</th>
                        </tr>
                    </thead>
                    <tbody id="top5Body">
                        {{! top5RankList 순회: 각 BookRank 렌더링 }}
                        {{#top5RankList}}
                        <tr data-cert="{{certName}}">
                            <td class="text-center fw-bold" style="color:#6366f1; white-space:nowrap;">{{rank}}</td>
                            <td>
                                <div style="font-size:0.8rem;">{{bookTitle}}</div>
                                <div style="font-size:0.73rem; color:#94a3b8;">{{certName}}</div>
                            </td>
                            <td class="text-center">
                                {{! num-fmt: footer.js에서 천단위 콤마 자동 적용 }}
                                <span class="badge badge-indigo num-fmt">{{count}}</span>
                            </td>
                        </tr>
                        {{/top5RankList}}
                    </tbody>
                </table>
                <div class="card-footer text-end">
                    <a href="/reviews/ranking" class="btn btn-soft btn-sm">전체 보기</a>
                </div>
            </div>
        </div>

        {{! 최신 합격 후기 카드: ID 내림차순으로 최대 5개 표시 }}
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">최신 합격 후기</div>
                <ul class="list-group list-group-flush">
                    {{#recentPassedList}}
                    <li class="list-group-item px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge badge-green me-1">합격</span>
                                <strong style="font-size:0.88rem;">{{certName}}</strong>
                                <div class="mt-1" style="font-size:0.77rem; color:#94a3b8;">{{bookTitle}} · {{studyPeriod}}</div>
                            </div>
                            <a href="/reviews/{{id}}" class="btn btn-soft btn-sm">보기</a>
                        </div>
                    </li>
                    {{/recentPassedList}}
                </ul>
            </div>
        </div>
    </div>

    {{! 자격증별 요약 테이블
        5개/페이지 페이지네이션 + 자격증명 검색 필터 (모두 JS 처리)
        data-cert: filterCertSummary()의 키워드 매칭 대상
        diffLow/Mid/High: CertSummary.getDiffLow/Mid/High() Mustache 조건 블록 }}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>자격증별 요약</span>
            {{! certSummaryCount: JS 필터링 후 매칭 수로 동적 업데이트됨 }}
            <span id="certSummaryCount" class="result-count" style="padding:0; border:none; font-size:0.77rem;">총 {{certCount}}개</span>
        </div>
        <div style="padding:0.7rem 1.25rem; background:#f8fafc; border-bottom:1px solid #e5e7eb;">
            <input type="text" id="certSummarySearch" class="form-control form-control-sm"
                   placeholder="자격증 검색" autocomplete="off" oninput="filterCertSummary(this.value)">
        </div>
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>자격증</th>
                    <th class="text-center" style="width:70px;">리뷰 수</th>
                    <th style="min-width:140px;">합격률</th>
                    <th class="text-center" style="width:80px;">난이도</th>
                    <th>주요 교재</th>
                    <th class="text-center" style="width:110px;">바로가기</th>
                </tr>
            </thead>
            <tbody id="certSummaryBody">
                {{! certSummaryList 전체 행 렌더링 (표시/숨김은 JS가 제어) }}
                {{#certSummaryList}}
                <tr data-cert="{{certName}}">
                    <td class="fw-semibold" style="white-space:nowrap;">{{certName}}</td>
                    <td class="text-center num-fmt" style="color:#94a3b8;">{{totalCount}}</td>
                    <td>
                        {{! 합격률 progress bar: footer.js에서 0→목표값 애니메이션 }}
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1">
                                <div class="progress-bar" data-width="{{passRateNum}}" style="background:#818cf8; width:0%; border-radius:10px;"></div>
                            </div>
                            <small class="pass-rate-label" data-target="{{passRateNum}}" style="min-width:34px; color:#6366f1; font-weight:600; text-align:right;">0%</small>
                        </div>
                    </td>
                    <td class="text-center">
                        {{! Mustache 조건 블록: CertSummary.getDiffLow/Mid/High() 반환값에 따라 하나만 렌더링 }}
                        {{#diffLow}}<span class="badge badge-diff-low">하</span>{{/diffLow}}
                        {{#diffMid}}<span class="badge badge-diff-mid">중</span>{{/diffMid}}
                        {{#diffHigh}}<span class="badge badge-diff-high">상</span>{{/diffHigh}}
                    </td>
                    <td style="color:#94a3b8; font-size:0.83rem;">{{topBook}}</td>
                    {{! 해당 자격증의 통계/교재 랭킹 페이지 직접 링크 }}
                    <td class="text-center" style="white-space:nowrap;">
                        <a href="/reviews/stats?certName={{certName}}" class="btn btn-sm me-1" style="background:#eef2ff; border:1px solid #c7d2fe; color:#6366f1; font-size:0.75rem;">통계</a>
                        <a href="/reviews/ranking?certName={{certName}}" class="btn btn-sm" style="background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a; font-size:0.75rem;">교재 추천</a>
                    </td>
                </tr>
                {{/certSummaryList}}
            </tbody>
        </table>
        {{! 자격증 요약 페이지네이션: JS renderPagination() 함수가 동적으로 생성 }}
        <div class="d-flex flex-column align-items-center gap-1 py-2">
            <nav><ul id="certPagination" class="pagination pagination-sm mb-0"></ul></nav>
            <div id="certPageInfo" class="page-info-text"></div>
        </div>
    </div>

    {{! 전체 리뷰 목록
        필터: 자격증/교재명 텍스트 검색 + 합격여부 select + 난이도 select (모두 JS 처리)
        클릭: onclick="location.href='/reviews/{{id}}'" → 상세 페이지로 이동
        data-* 속성: JS 필터링에서 비교 대상 }}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>전체 리뷰 목록</span>
            <a href="/reviews/new" class="btn btn-primary btn-sm">리뷰 작성</a>
        </div>
        {{! 필터 바: oninput/onchange → filterReviews() 즉시 실행 }}
        <div class="filter-bar">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <div class="section-label mb-1">자격증 / 교재명</div>
                    <input type="text" id="reviewSearch" class="form-control form-control-sm"
                           placeholder="검색어 입력" oninput="filterReviews()">
                </div>
                <div class="col-md-3">
                    <div class="section-label mb-1">합격 여부</div>
                    <select id="reviewPassed" class="form-select form-select-sm" onchange="filterReviews()">
                        <option value="all">전체</option>
                        <option value="Y">합격</option>
                        <option value="N">불합격</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="section-label mb-1">난이도</div>
                    <select id="reviewDiff" class="form-select form-select-sm" onchange="filterReviews()">
                        <option value="all">전체</option>
                        <option value="하">하</option>
                        <option value="중">중</option>
                        <option value="상">상</option>
                    </select>
                </div>
            </div>
        </div>
        {{! reviewCount: JS 필터링 결과 수로 동적 업데이트 }}
        <div id="reviewCount" class="result-count">총 {{total}}건</div>
        <table class="table mb-0">
            <thead>
                <tr>
                    <th style="width:60px;">번호</th>
                    <th>자격증</th>
                    <th>교재</th>
                    <th class="text-center" style="width:80px;">난이도</th>
                    <th class="text-center" style="width:70px;">합격</th>
                    <th style="width:100px;">공부기간</th>
                </tr>
            </thead>
            <tbody id="reviewBody">
                {{! reviewList 전체 렌더링 (표시/숨김은 JS 페이지네이션·필터가 제어)
                    data-* 속성에 값 저장 → JS에서 서버 재요청 없이 클라이언트 필터링 }}
                {{#reviewList}}
                <tr data-cert="{{certName}}" data-book="{{bookTitle}}"
                    data-passed="{{passed}}" data-diff="{{difficulty}}"
                    onclick="location.href='/reviews/{{id}}'" style="cursor:pointer;">
                    <td style="color:#cbd5e1;">{{id}}</td>
                    <td>{{certName}}</td>
                    <td style="color:#64748b;">{{bookTitle}}</td>
                    <td class="text-center">
                        {{! 난이도 배지: Review.getDiffLow/Mid/High() Mustache 조건 블록 }}
                        {{#diffLow}}<span class="badge badge-diff-low">하</span>{{/diffLow}}
                        {{#diffMid}}<span class="badge badge-diff-mid">중</span>{{/diffMid}}
                        {{#diffHigh}}<span class="badge badge-diff-high">상</span>{{/diffHigh}}
                    </td>
                    <td class="text-center">
                        {{! 합격 배지: Review.getPassedY/N() Mustache 조건 블록 }}
                        {{#passedY}}<span class="badge badge-green">합격</span>{{/passedY}}
                        {{#passedN}}<span class="badge badge-red">불합격</span>{{/passedN}}
                    </td>
                    <td style="color:#94a3b8;">{{studyPeriod}}</td>
                </tr>
                {{/reviewList}}
            </tbody>
        </table>
        {{! 전체 리뷰 목록 페이지네이션: JS renderPagination() 동적 생성 }}
        <div class="d-flex flex-column align-items-center gap-1 py-3">
            <nav><ul id="reviewPagination" class="pagination pagination-sm mb-0"></ul></nav>
            <div id="reviewPageInfo" class="page-info-text"></div>
        </div>
    </div>

</div>

<script>
// 페이지당 표시 개수 상수
var CERT_PAGE_SIZE = 5;    // 자격증별 요약 테이블
var REVIEW_PAGE_SIZE = 10; // 전체 리뷰 목록

// ── 자격증별 요약 페이지네이션 + 검색 필터 ──────────────
var certRows = Array.from(document.querySelectorAll("#certSummaryBody tr"));  // 전체 행 캐시
var certCurrentPage = 1;
var certFiltered = certRows.slice();  // 필터링된 행 목록 (초기: 전체)

/**
 * 자격증명 검색 필터: data-cert 속성과 키워드 매칭.
 * 필터 결과를 certFiltered에 저장 후 페이지 1로 리셋하고 renderCertPage 호출.
 */
function filterCertSummary(query) {
    var keyword = query.trim().toLowerCase();
    certFiltered = certRows.filter(function(row) {
        return keyword === "" || (row.getAttribute("data-cert") || "").toLowerCase().includes(keyword);
    });
    certCurrentPage = 1;
    renderCertPage();
}

/**
 * 현재 페이지에 해당하는 자격증 요약 행만 표시.
 * certFiltered 중 [(page-1)*5, page*5) 범위 행만 display:""로 설정.
 */
function renderCertPage() {
    var total = certFiltered.length;
    var totalPages = Math.max(1, Math.ceil(total / CERT_PAGE_SIZE));
    if (certCurrentPage > totalPages) certCurrentPage = totalPages;
    var start = (certCurrentPage - 1) * CERT_PAGE_SIZE;

    certRows.forEach(function(r) { r.style.display = "none"; });  // 전체 숨김
    certFiltered.slice(start, start + CERT_PAGE_SIZE).forEach(function(r) { r.style.display = ""; });  // 현재 페이지 표시

    document.getElementById("certSummaryCount").textContent = "총 " + total.toLocaleString("ko-KR") + "개";
    renderPagination("certPagination", "certPageInfo", certCurrentPage, totalPages, function(p) {
        certCurrentPage = p; renderCertPage();
    });
}

// ── 전체 리뷰 목록 페이지네이션 + 다중 필터 ──────────────
var reviewRows = Array.from(document.querySelectorAll("#reviewBody tr"));  // 전체 행 캐시
var reviewCurrentPage = 1;
var reviewFiltered = reviewRows.slice();  // 필터링된 행 목록 (초기: 전체)

/**
 * 리뷰 목록 다중 필터: 키워드(자격증+교재) + 합격여부 + 난이도.
 * 각 행의 data-* 속성과 비교해 모든 조건을 만족하는 행만 필터링.
 */
function filterReviews() {
    var keyword = document.getElementById("reviewSearch").value.trim().toLowerCase();
    var passed  = document.getElementById("reviewPassed").value;   // "all", "Y", "N"
    var diff    = document.getElementById("reviewDiff").value;     // "all", "하", "중", "상"
    reviewFiltered = reviewRows.filter(function(row) {
        var cert    = (row.getAttribute("data-cert") || "").toLowerCase();
        var book    = (row.getAttribute("data-book") || "").toLowerCase();
        var rPassed = row.getAttribute("data-passed") || "";
        var rDiff   = row.getAttribute("data-diff") || "";
        // AND 조건: 키워드(자격증 OR 교재) + 합격여부 + 난이도 모두 통과해야 포함
        return (keyword === "" || cert.includes(keyword) || book.includes(keyword))
            && (passed === "all" || passed === rPassed)
            && (diff   === "all" || diff   === rDiff);
    });
    reviewCurrentPage = 1;
    renderReviewPage();
}

/**
 * 현재 페이지에 해당하는 리뷰 행만 표시.
 * reviewFiltered 중 [(page-1)*10, page*10) 범위 행만 표시.
 */
function renderReviewPage() {
    var total = reviewFiltered.length;
    var totalPages = Math.max(1, Math.ceil(total / REVIEW_PAGE_SIZE));
    if (reviewCurrentPage > totalPages) reviewCurrentPage = totalPages;
    var start = (reviewCurrentPage - 1) * REVIEW_PAGE_SIZE;

    reviewRows.forEach(function(r) { r.style.display = "none"; });  // 전체 숨김
    reviewFiltered.slice(start, start + REVIEW_PAGE_SIZE).forEach(function(r) { r.style.display = ""; });  // 현재 페이지 표시

    document.getElementById("reviewCount").textContent = "총 " + total.toLocaleString("ko-KR") + "건";
    renderPagination("reviewPagination", "reviewPageInfo", reviewCurrentPage, totalPages, function(p) {
        reviewCurrentPage = p; renderReviewPage();
    });
}

/**
 * 공통 페이지네이션 버튼 생성 함수.
 * 현재 ±2 윈도우 + 첫/끝 페이지 항상 포함, 생략 구간에 "…" 표시.
 *
 * @param containerId  페이지네이션 <ul> 요소 ID
 * @param infoId       "n / m 페이지" 텍스트 표시 요소 ID
 * @param current      현재 페이지 번호
 * @param totalPages   전체 페이지 수
 * @param goPage       페이지 변경 콜백 함수 (페이지 번호 인수)
 */
function renderPagination(containerId, infoId, current, totalPages, goPage) {
    var ul = document.getElementById(containerId);
    var infoEl = document.getElementById(infoId);
    ul.innerHTML = "";
    if (infoEl) infoEl.textContent = "";
    if (totalPages <= 1) return;  // 1페이지면 페이지네이션 불필요

    /**
     * 개별 페이지 버튼 생성 헬퍼.
     * @param label      버튼 레이블 (HTML)
     * @param page       이동할 페이지 번호
     * @param active     현재 페이지 여부 (active 스타일)
     * @param disabled   비활성화 여부 (첫/끝 페이지에서 이전/다음)
     * @param isEllipsis "…" 구분자 여부 (클릭 불가)
     */
    function makeBtn(label, page, active, disabled, isEllipsis) {
        var li = document.createElement("li");
        li.className = "page-item" + (active ? " active" : "") + (disabled ? " disabled" : "");
        var a = document.createElement("a");
        a.className = "page-link";
        a.href = "#";
        a.innerHTML = label;
        if (isEllipsis) {
            a.style.cssText = "pointer-events:none; color:#cbd5e1; border:none; background:transparent; padding:0.32rem 0.3rem;";
        }
        a.addEventListener("click", function(e) {
            e.preventDefault();
            if (!disabled && !isEllipsis) goPage(page);
        });
        li.appendChild(a);
        ul.appendChild(li);
    }

    // 첫 페이지(«), 이전(‹) 버튼
    makeBtn("&laquo;", 1,           false, current === 1, false);
    makeBtn("&lsaquo;", current - 1, false, current === 1, false);

    // 현재 ±2 윈도우 + 첫/끝 페이지 항상 포함 (슬라이딩 윈도우 알고리즘)
    var delta = 2;
    var pages = [];
    for (var i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= current - delta && i <= current + delta)) {
            pages.push(i);
        }
    }
    var prev = 0;
    for (var j = 0; j < pages.length; j++) {
        var p = pages[j];
        if (prev && p - prev > 1) makeBtn("…", 0, false, false, true);  // 생략 구간 "…"
        makeBtn(p, p, p === current, false, false);
        prev = p;
    }

    // 다음(›), 끝 페이지(») 버튼
    makeBtn("&rsaquo;", current + 1,  false, current === totalPages, false);
    makeBtn("&raquo;",  totalPages,   false, current === totalPages, false);

    // 페이지 위치 정보 텍스트 (예: "3 / 10 페이지")
    if (infoEl) infoEl.textContent = current + " / " + totalPages + " 페이지";
}

/**
 * TOP5 테이블 자격증명 검색 필터.
 * data-cert 속성과 키워드 매칭해 행 표시/숨김.
 */
function filterTop5(query) {
    var keyword = query.trim().toLowerCase();
    document.querySelectorAll("#top5Body tr").forEach(function(row) {
        var cert = (row.getAttribute("data-cert") || "").toLowerCase();
        row.style.display = (keyword === "" || cert.includes(keyword)) ? "" : "none";
    });
}

// 페이지 로드 시 초기 렌더링 (전체 데이터 기준 1페이지 표시)
renderCertPage();
renderReviewPage();
</script>

