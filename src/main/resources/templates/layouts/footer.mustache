<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
<script>
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    // num-fmt: 콤마 포맷
    document.querySelectorAll(".num-fmt").forEach(function(el) {
        var n = parseInt(el.textContent.replace(/,/g, ""), 10);
        if (!isNaN(n)) el.textContent = n.toLocaleString("ko-KR");
    });

    // 카드 fade + slide-up — 화면에 보일 때 순서대로
    (function() {
        var cards = Array.from(document.querySelectorAll(".stat-card, .card"));
        if (!cards.length) return;
        var done = new Set();
        var obs = new IntersectionObserver(function(entries) {
            var visible = entries.filter(function(e) { return e.isIntersecting && !done.has(e.target); });
            visible.forEach(function(entry, i) {
                done.add(entry.target);
                setTimeout(function() { entry.target.classList.add("is-visible"); }, i * 80);
            });
        }, { threshold: 0.15 });
        cards.forEach(function(c) { obs.observe(c); });
    })();

    // 프로그레스 바 애니메이션 — 화면에 보일 때 순서대로
    (function() {
        var bars = Array.from(document.querySelectorAll(".progress-bar[data-width]"));
        if (!bars.length) return;
        var done = new Set();
        var DURATION = 850;

        function easeOut(t) { return 1 - Math.pow(1 - t, 2); }

        function animateLabel(label, target, delay) {
            setTimeout(function() {
                var start = null;
                function tick(ts) {
                    if (!start) start = ts;
                    var elapsed = ts - start;
                    var progress = Math.min(elapsed / DURATION, 1);
                    label.textContent = Math.round(easeOut(progress) * target) + "%";
                    if (progress < 1) requestAnimationFrame(tick);
                }
                requestAnimationFrame(tick);
            }, delay);
        }

        var obs = new IntersectionObserver(function(entries) {
            var visible = entries.filter(function(e) {
                return e.isIntersecting && !done.has(e.target);
            });
            visible.forEach(function(entry, i) {
                done.add(entry.target);
                var bar = entry.target;
                var w = parseFloat(bar.getAttribute("data-width")) || 0;
                var delay = i * 100 + 60;
                bar.style.transition = "width " + (DURATION / 1000) + "s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
                setTimeout(function() { bar.style.width = w + "%"; }, delay);

                var row = bar.closest(".d-flex");
                if (row) {
                    var label = row.querySelector(".pass-rate-label");
                    if (label) animateLabel(label, w, delay);
                }
            });
        }, { threshold: 0.1 });

        bars.forEach(function(bar) {
            bar.style.width = "0%";
            obs.observe(bar);
        });
    })();
</script>
</body>
</html>
